<div class="container-fluid bg-light min-vh-100 p-4">
    <h2 class="mb-4">Dashboard General</h2>

    <div class="row mb-4">
        <div class="col-md">
            <div class="card shadow-sm border-0 text-center p-3 border-start border-primary border-4">
                <small class="text-muted">Total de Usuarios</small>
                <h3 class="fw-bold">{{stats.total}}</h3>
                <small class="text-secondary">En base de datos</small>
            </div>
        </div>
        <div class="col-md">
            <div class="card shadow-sm border-0 text-center p-3 border-start border-success border-4">
                <small class="text-muted text-success">Usuarios Activos</small>
                <h3 class="fw-bold text-success">{{stats.activos}}</h3>
                <small class="text-secondary">Listos para uso</small>
            </div>
        </div>
        <div class="col-md">
            <div class="card shadow-sm border-0 text-center p-3 border-start border-danger border-4">
                <small class="text-muted text-danger">Inactivos</small>
                <h3 class="fw-bold text-danger">{{stats.inactivos}}</h3>
                <small class="text-secondary">Fuera de servicio</small>
            </div>
        </div>
        <div class="col-md">
            <div class="card shadow-sm border-0 text-center p-3 border-start border-warning border-4">
                <small class="text-muted text-warning">Pendientes</small>
                <h3 class="fw-bold text-warning">{{stats.pendientes}}</h3>
                <small class="text-secondary">En revisión</small>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4 h-100">
                <h6 class="text-muted mb-3"><i class="fa-solid fa-user-plus"></i> Último Usuario Creado</h6>
                <h4 class="fw-bold text-primary">{{stats.ultimoCreado.name}} {{stats.ultimoCreado.lastname}}</h4>
                <p class="mb-1 text-muted small">Registrado el: {{stats.ultimoCreado.created_at}}</p>
                <p class="mb-0">Usuario: <strong>{{stats.ultimoCreado.user}}</strong> - Tipo: {{stats.ultimoCreado.categoria}}</p>
                <span class="badge bg-primary mt-2 w-25">Estado: {{stats.ultimoCreado.estado}}</span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4 h-100">
                <h6 class="text-muted mb-3"><i class="fa-solid fa-pen-to-square"></i> Último Usuario Actualizado</h6>
                <h4 class="fw-bold text-success">{{stats.ultimoActualizado.name}} {{stats.ultimoActualizado.lastname}}</h4>
                <p class="mb-1 text-muted small">Actualizado el: {{stats.ultimoActualizado.updated_at}}</p>
                <p class="mb-0">Correo: <strong>{{stats.ultimoActualizado.correo}}</strong></p>
                <span class="badge bg-success mt-2 w-25">Estado: {{stats.ultimoActualizado.estado}}</span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4 h-100">
                <h6 class="mb-3 text-center fw-bold">Distribución por Categoría</h6>
                <div style="height: 300px;">
                    <canvas id="graficoCategoria"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4 h-100">
                <h6 class="mb-3 text-center fw-bold">Resumen de Usuarios por Estado</h6>
                <div style="height: 300px;">
                    <canvas id="graficoEstados"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    //Configuración Gráfico de Dona (Categorías)
    const ctxDona = document.getElementById('graficoCategoria');
    new Chart(ctxDona, {
        type: 'doughnut',
        data: {
            labels: [{{#each stats.porCategoria}}'{{this.categoria}}',{{/each}}],
            datasets: [{
                data: [{{#each stats.porCategoria}}{{this.cantidad}},{{/each}}],
                backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6c757d']
            }]
        },
        options: { 
            cutout: '65%',
            maintainAspectRatio: false 
        }
    });

    //Configuración Gráfico de Barras (Estados)
    const ctxBarra = document.getElementById('graficoEstados');
    new Chart(ctxBarra, {
        type: 'bar',
        data: {
            labels: ['Activos', 'Inactivos', 'Pendientes'],
            datasets: [{
                label: 'Usuarios',
                data: [{{stats.activos}}, {{stats.inactivos}}, {{stats.pendientes}}],
                backgroundColor: [
                    'rgba(25, 135, 84, 0.7)', 
                    'rgba(220, 53, 69, 0.7)', 
                    'rgba(255, 193, 7, 0.7)'  
                ],
                borderColor: ['#198754', '#dc3545', '#ffc107'],
                borderWidth: 1
            }]
        },
        options: {
            maintainAspectRatio: false,
            scales: {
                y: { beginAtZero: true, ticks: { stepSize: 1 } }
            },
            plugins: {
                legend: { display: false }
            }
        }
    });
</script>